# URL del backend (Desarrollo_Web1_Backend). En local normalmente http://localhost:3000
VITE_API_URL=http://localhost:3000

# true = usa los datos de public/mockups sin necesitar el backend
VITE_USE_MOCKS=false

# Clave PUBLICA de Stripe (pk_test_... o pk_live_...). Es segura para el navegador. Con ella la tarjeta se escribe en
# los campos seguros de Stripe y al backend solo llega un payment_method (obligatorio en produccion).
# Sin ella solo funciona el modo local de pruebas, donde el backend acepta la tarjeta de prueba directamente.
VITE_STRIPE_PUBLISHABLE_KEY=
